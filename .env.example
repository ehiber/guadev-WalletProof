# Copia este archivo a .env.local y rellena las claves.
# Next.js carga .env.local al arrancar `npm run dev`.
# Chat y correo usan estas variables. El botón "Subir factura" usa primero
# las claves guardadas en el navegador (API Keys) y, si faltan, estas.
# Lectura y redacción hablan con OpenAI. JEV sigue siendo TypeSafe.

# --- Capa de lectura (JSON de la factura) ---
BLINKA_READ_PROVIDER=openai
BLINKA_READ_API_KEY=
BLINKA_READ_MODEL=gpt-5-nano
BLINKA_READ_FALLBACK_MODEL=gpt-6-luna

# --- Capa de redacción (reescribe el párrafo; no cambia el veredicto) ---
BLINKA_EXPLAIN_PROVIDER=openai
BLINKA_EXPLAIN_API_KEY=
BLINKA_EXPLAIN_MODEL=gpt-5-nano
BLINKA_EXPLAIN_FALLBACK_MODEL=gpt-6-luna

# --- JEV (TypeSafe). Solo corre si las reglas duras pasan. ---
TYPESAFE_JEV_KEY=
# TYPESAFE_JEV_URL=https://api.typesafe.ai/v1/systemone

# --- OpenClaw. Si se omite, el secreto de la demo es blinka-demo. ---
# OPENCLAW_WEBHOOK_SECRET=blinka-demo

# --- Gmail. El buzón que recibe facturas sintéticas. Los secretos van en .env, no aquí. ---
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
